# Secreto compartido con el panel (mismo valor que WHATSAPP_GATEWAY_SECRET en Vercel).
# Genera uno con: openssl rand -hex 32
WA_GATEWAY_SECRET=

# Puerto HTTP (Railway/Render lo inyectan solos).
PORT=8787
# En este PC debe seguir en localhost; el puente realiza conexiones salientes.
HOST=127.0.0.1

# Carpeta donde se guardan la sesión y los chats. En Docker, monta aquí un volumen persistente.
WA_DATA_DIR=./data

# Mostrar también los grupos en la bandeja (por defecto, solo chats individuales).
WA_INCLUDE_GROUPS=false

# Enviar el doble check azul cuando la central abre un chat en el panel.
WA_SEND_READ_RECEIPTS=true

# Mensajes guardados por chat.
WA_MAX_MESSAGES_PER_CHAT=300

# trace | debug | info | warn | error
WA_LOG_LEVEL=warn
